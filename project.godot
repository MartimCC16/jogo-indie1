; Arquivo de configuração do projeto Godot.
; Você pode editar tudo isto pelo editor em: Projeto > Configurações do Projeto.
; (Comentários com ";" são apagados pelo Godot quando ele salva o arquivo.)

config_version=5

[application]

config/name="Névoa e Aço"
config/description="RPG de fantasia medieval em pixel art. Reino de Vésper, Névoa do Esquecimento."
run/main_scene="res://scenes/teste/teste_pixel.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

